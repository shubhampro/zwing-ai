APP_NAME="Zwing AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Dynamic remote DB connections: store credentials in the `database_connections`
# table (slug = Laravel connection name). Pair rows with the same connection_group:
# access_mode=read (writes blocked in app for SQL) and access_mode=write with
# writes_enabled=true when you want ResolvesRemoteWriteConnection::writeForGroup().
# Optional: DYNAMIC_DB_READ_ONLY_GUARD_ENABLED=false to disable the SQL guard.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Connection stock pulls use queue "stock-recon-connections".
# php artisan queue:work --queue=stock-recon-connections,default

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MySQL via SSH tunnel (lazy open when required)
MYSQL_SSH_HOST=
MYSQL_SSH_PORT=22
MYSQL_SSH_USER=
# Filename under ~/.ssh (e.g. id_ed25519_work) or absolute path inside ~/.ssh
MYSQL_SSH_KEY=
MYSQL_SSH_REMOTE_HOST=127.0.0.1
MYSQL_SSH_REMOTE_PORT=3306
MYSQL_SSH_LOCAL_PORT=3307

# MySQL credentials through the local tunnel end
MYSQL_REMOTE_DATABASE=
MYSQL_REMOTE_USERNAME=
MYSQL_REMOTE_PASSWORD=

# Postgres SSH bastion only (org row holds per-org remote DB host/port + login)
PGSQL_SSH_HOST=
PGSQL_SSH_PORT=22
PGSQL_SSH_USER=
PGSQL_SSH_KEY=
# Fallback remote target when org host is blank
PGSQL_SSH_REMOTE_HOST=127.0.0.1
PGSQL_SSH_REMOTE_PORT=5432
PGSQL_SSH_LOCAL_PORT=5433
PGSQL_SSH_SSLMODE=prefer

# MongoDB via SSH tunnel
MONGODB_SSH_LOCAL_PORT=37017
MONGODB_SSH_REMOTE_HOST=127.0.0.1
MONGODB_SSH_REMOTE_PORT=27017
MONGODB_SSH_DATABASE=
MONGODB_SSH_USERNAME=
MONGODB_SSH_PASSWORD=

GINESYS_RETAIL_VOID_PATH=/api/rt/RetailInvoice/Adhoc
GINESYS_REQUEST_DELAY_MS=250
