APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Dynamic remote DB connections: store credentials in the `database_connections`
# table (slug = Laravel connection name). Pair rows with the same connection_group:
# access_mode=read (writes blocked in app for SQL) and access_mode=write with
# writes_enabled=true when you want ResolvesRemoteWriteConnection::writeForGroup().
# Optional: DYNAMIC_DB_READ_ONLY_GUARD_ENABLED=false to disable the SQL guard.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Salesforce (for salesforce-rca-analyzer agent --fetch mode)

# Option A — paste access_token from sidexchange API (expires ~30 min)
SALESFORCE_INSTANCE_URL=https://ginesys-one.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=

# Option B — auto refresh via browser session cookie
SALESFORCE_LIGHTNING_URL=https://ginesys-one.lightning.force.com
SALESFORCE_SID=

# Option C — Connected App OAuth password grant
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# Optional custom RCA field on Case object
SALESFORCE_RCA_FIELD=

# MySQL Remote (direct connection)
MYSQL_REMOTE_HOST=
MYSQL_REMOTE_PORT=3306
MYSQL_REMOTE_DATABASE=
MYSQL_REMOTE_USERNAME=
MYSQL_REMOTE_PASSWORD=

# MongoDB via SSH tunnel (or direct — set port to 27017 for local MongoDB)
# Optional full URI (overrides host/port when set): mongodb://user:pass@host:27017/zwing
MONGODB_URI=
MONGODB_SSH_LOCAL_PORT=37017
MONGODB_SSH_HOST=127.0.0.1
MONGODB_SSH_DATABASE=
MONGODB_SSH_USERNAME=
MONGODB_SSH_PASSWORD=
# Aliases also supported: MONGO_DB_HOST, MONGO_DB_PORT, MONGO_DB_DATABASE, MONGO_DB_USERNAME, MONGO_DB_PASSWORD

# Inbound sync (MongoDB collection name)
INBOUND_SYNC_COLLECTION=inbound_apis

# Model-AI microservice (store credit predictions)
MODEL_AI_URL=http://127.0.0.1:8000
MODEL_AI_DEFAULT_DATASET_KEY=store_credit_notes
MODEL_AI_DEFAULT_TRAIN_TARGETS=is_redeemed,payment_mode,customer_name

# ZWING To ERP integration (outbound unsync check)
ZWING_TO_ERP_BASE_URL=https://connect.gozwing.com
ZWING_TO_ERP_USERNAME=
ZWING_TO_ERP_PASSWORD=
